<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@android:drawable/dialog_holo_light_frame">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thông tin hành khách"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#000000"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvDetailName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tên: Đang tải..."
        android:textSize="15sp"
        android:textColor="#333333"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvDetailEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Email: Đang tải..."
        android:textSize="15sp"
        android:textColor="#333333"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvDetailPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SĐT: Đang tải..."
        android:textSize="15sp"
        android:textColor="#333333"
        android:layout_marginBottom="20dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCloseDetail"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Đóng"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:background="#0d93e0" />

</LinearLayout>