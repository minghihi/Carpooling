<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@android:drawable/dialog_holo_light_frame">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quản lý chuyến đi"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#000000"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F5F5F5"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvDialogRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tuyến: ..."
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDialogTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Thời gian: ..."
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvDialogSeats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Số ghế trống: ..."
            android:textColor="#d9534f"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnEditRide"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Sửa thông tin chuyến đi"
        android:background="@drawable/bg_custom_button"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCallPassenger"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Gọi điện"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_green_button"
            android:layout_marginEnd="6dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnChatPassenger"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Nhắn tin"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_custom_button"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnManagePassengers"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Quản lý hành khách và Duyệt chỗ"
        android:background="@drawable/bg_custom_button"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnStartRide"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Bắt đầu hành trình"
        android:background="@drawable/bg_green_button"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCompleteRide"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Hoàn thành chuyến đi"
        android:background="@drawable/bg_custom_button"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCancelRide"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Hủy chuyến đi"
        android:background="@drawable/bg_exit_button"
        android:textColor="#FFFFFF" />

</LinearLayout>