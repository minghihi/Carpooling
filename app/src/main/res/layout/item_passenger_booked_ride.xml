<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/tvBookedRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hà Nội ➔ Hải Phòng"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvBookedTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Khởi hành: 2026-06-01 08:00:00"
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvBookingStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Trạng thái đơn: PENDING"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#E65100"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnOpenRideManage"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Vào phòng Gọi &amp; Chat với tài xế"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"/>

        <Button
            android:id="@+id/btnBackHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quay về trang chủ"
            android:backgroundTint="#757575"
            android:textColor="#FFFFFF"
            android:layout_marginTop="12dp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>