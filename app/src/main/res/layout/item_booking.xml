<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:background="@android:color/white"
    android:elevation="4dp">

    <TextView
        android:id="@+id/tvBookingId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mã đặt chỗ: #1"
        android:textColor="@android:color/black"
        android:textStyle="bold"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvPassengerId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mã hành khách: 102"
        android:layout_marginTop="4dp"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvSeatsBooked"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Số ghế đặt: 1"
        android:layout_marginTop="4dp"
        android:textColor="#FF9800"
        android:textStyle="bold"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Từ chối/Hủy"
            android:backgroundTint="#F44336"
            android:textColor="@android:color/white"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnAccept"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phê duyệt"
            android:backgroundTint="#00CCCC"
            android:textColor="@android:color/white" />
    </LinearLayout>
</LinearLayout>