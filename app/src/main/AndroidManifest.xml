<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Carpooling"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".activities.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:label="Danh sách chuyến xe"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.MapActivity"
            android:exported="false"
            android:label="@string/title_activity_map"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.CurrentRideActivity"
            android:exported="false"
            android:label="Chuyến Đi Hiện Tại"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.ChatActivity"
            android:exported="false"
            android:label="Phòng Chat"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name=".activities.DriverActivity"
            android:exported="false"
            android:label="Giao diện Tài xế" />

        <activity
            android:name=".activities.DriverLiveMapActivity"
            android:exported="false"
            android:label="Bản Đồ Trực Tuyến Tài Xế" />

        <activity
            android:name=".activities.CreateRideActivity"
            android:exported="false"
            android:label="Đăng Chuyến Xe" />

        <activity
            android:name=".activities.PassengerTrackingActivity"
            android:exported="false"
            android:label="Bản Đồ Tracking Chuyến Đi"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.PickLocationActivity"
            android:exported="false"
            android:label="Chọn vị trí trên bản đồ" />

        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".activities.BookingHistoryActivity"
            android:exported="false"
            android:label="Lịch sử chuyến đi" />

        <activity
            android:name=".activities.ProfileActivity"
            android:exported="false"
            android:label="Thông tin cá nhân" />

        <activity
            android:name=".activities.SupportCenterActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".activities.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".activities.PaymentActivity"
            android:exported="false"
            android:label="Xác Nhận Thanh Toán"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.WalletPaymentActivity"
            android:exported="false"
            android:label="Thanh Toán Trực Tuyến"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".RatingActivity"
            android:exported="false"
            android:label="Đánh Giá Chuyến Đi"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.SystemLogActivity"
            android:exported="false"
            android:label="Nhật Ký Hệ Thống" />

        <activity
            android:name=".activities.AdminDashboardActivity"
            android:exported="false"
            android:label="Bảng Điều Khiển Quản Trị"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.AdminUserManagementActivity"
            android:exported="false"
            android:label="Quản Lý Người Dùng"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.AdminRideModerationActivity"
            android:exported="false"
            android:label="Quản Lý Danh Sách Chuyến Đi"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.AdminSupportActivity"
            android:exported="false"
            android:label="Quản Lý Khiếu Nại" />

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <service
            android:name=".services.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>